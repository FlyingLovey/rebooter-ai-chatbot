# ===== LLM (OpenAI-compatible) =====
# OpenRouter: https://openrouter.ai/api/v1  |  LM Studio: http://127.0.0.1:1234/v1
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx
CHAT_MODEL=openai/gpt-4o-mini
# โมเดลที่อ่านภาพได้ (vision)
VISION_MODEL=openai/gpt-4o-mini
LLM_TEMPERATURE=0.2

# ===== RAG =====
KNOWLEDGE_PATH=../knowledge/Rebooter.md
CHROMA_DIR=chroma_db
RAG_TOP_K=4
# local = sentence-transformers บนเครื่อง (โหลดโมเดลครั้งแรก ~470MB)
# api   = เรียก {EMBEDDING_BASE_URL}/embeddings เช่น LM Studio http://127.0.0.1:1234/v1
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# ===== Guard Service (โฟลเดอร์ guard/) =====
GUARD_ENABLED=true
GUARD_URL=http://127.0.0.1:8001

# ===== App =====
MAX_MESSAGE_CHARS=1000
MAX_IMAGE_MB=5
HISTORY_TURNS=6
SHOP_PHONE=02-123-4567
